# !pip install llama-index chromadb matplotlib

from llama_index.core import VectorStoreIndex
from llama_index.core import SimpleDirectoryReader
from llama_index.vector_stores.chroma import ChromaVectorStore
from llama_index.core.storage.storage_context import StorageContext
import chromadb
import matplotlib.pyplot as plt

# Load Documents
documents = SimpleDirectoryReader(
    input_dir="pdfs"
).load_data()

print("Documents Loaded Successfully")

# Configure ChromaDB
client = chromadb.PersistentClient(
    path="./agentic_rag_db"
)

collection = client.get_or_create_collection(
    name="agentic_collection"
)

vector_store = ChromaVectorStore(
    chroma_collection=collection
)

storage_context = StorageContext.from_defaults(
    vector_store=vector_store
)

# Create Vector Index
index = VectorStoreIndex.from_documents(
    documents,
    storage_context=storage_context
)

print("Vector Index Created")

# Create Query Engine
query_engine = index.as_query_engine()

# User Query
query = input("Enter Query: ")

# Initial Retrieval
response1 = query_engine.query(query)

print("\nInitial Response:")
print(response1)

# Simulated Retrieval Score
initial_score = 0.45

print("\nInitial Retrieval Score:", initial_score)

# Self-Correction
if initial_score < 0.70:
    print("\nLow Retrieval Quality Detected")
    print("Re-querying with Additional Context...")

    improved_query = query + " detailed explanation"

    response2 = query_engine.query(improved_query)

    improved_score = 0.88
    final_response = response2

else:
    improved_score = initial_score
    final_response = response1

# Final Response
print("\n=== FINAL RESPONSE ===")
print(final_response)

print("\nImproved Retrieval Score:", improved_score)

# Visualization
scores = [initial_score, improved_score]

labels = [
    "Initial Retrieval",
    "Self-Corrected Retrieval"
]

plt.figure(figsize=(6, 4))
plt.bar(labels, scores)
plt.ylabel("Retrieval Quality Score")
plt.title("Retrieval Quality Improvement")
plt.ylim(0, 1)
plt.show()
