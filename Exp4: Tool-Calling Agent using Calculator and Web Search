import requests

# Calculator Tool
def calculator(expression):
    try:
        result = eval(expression)
        return f"Calculator Result: {result}"
    except Exception as e:
        return f"Calculator Error: {e}"


# Web Search Tool
def web_search(query):
    try:
        results = {
            "python": "Python is a high-level programming language.",
            "ai": "Artificial Intelligence enables machines to perform tasks intelligently.",
            "openai": "OpenAI develops advanced AI technologies."
        }

        query = query.lower()

        if query in results:
            return f"Web Result: {results[query]}"

        return "Web Result: No information found."

    except Exception as e:
        return f"Web Search Error: {e}"


# Tool Calling Agent
def tool_calling_agent(user_input):
    try:
        if any(op in user_input for op in ['+', '-', '*', '/']):
            print("Agent Decision: Calculator Tool")
            return calculator(user_input)

        elif user_input.lower().startswith("search"):
            print("Agent Decision: Web Search Tool")

            query = user_input.replace("search", "").strip()

            if query == "":
                return "Error: Empty search query."

            return web_search(query)

        else:
            return "Unsupported Request"

    except Exception as e:
        return f"Agent Error: {e}"


# Main Program
while True:
    user_input = input("\nEnter Query (or type exit): ")

    if user_input.lower() == "exit":
        print("Exiting Agent...")
        break

    response = tool_calling_agent(user_input)
    print(response)
