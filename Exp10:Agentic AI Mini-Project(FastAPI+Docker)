# FastAPI Application

from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI()


class Query(BaseModel):
    question: str


# Healthcare Agent
def healthcare_agent(question):
    if "fever" in question.lower():
        return "Possible viral infection. Consult a doctor."
    elif "headache" in question.lower():
        return "Stay hydrated and take proper rest."
    elif "cold" in question.lower():
        return "Drink warm fluids and monitor symptoms."
    else:
        return "Please consult a healthcare professional."


@app.post("/ask")
def ask_agent(query: Query):
    response = healthcare_agent(query.question)

    return {
        "question": query.question,
        "response": response
    }


##Dockerfile
FROM python:3.10

WORKDIR /app

COPY . /app

RUN pip install fastapi uvicorn

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

#Build Docker Image
docker build -t healthcare-agent .

#Run Docker Container
docker run -p 8000:8000 healthcare-agent
