from collections import deque

# Grid Size
ROWS = 5
COLS = 5

start = (0, 0)
goal = (4, 4)

# Possible Moves
moves = [
    (0, 1),   # Right
    (1, 0),   # Down
    (0, -1),  # Left
    (-1, 0)   # Up
]

# Greedy Search
def greedy_search(start, goal):
    current = start
    path = [current]

    while current != goal:
        x, y = current
        gx, gy = goal

        if x < gx:
            current = (x + 1, y)
        elif y < gy:
            current = (x, y + 1)

        path.append(current)

    return path

# Breadth First Search
def bfs(start, goal):
    queue = deque([(start, [start])])
    visited = set()

    while queue:
        node, path = queue.popleft()

        if node == goal:
            return path

        if node in visited:
            continue

        visited.add(node)

        for dx, dy in moves:
            nx = node[0] + dx
            ny = node[1] + dy

            if 0 <= nx < ROWS and 0 <= ny < COLS:
                queue.append(((nx, ny), path + [(nx, ny)]))

# Execute Searches
greedy_path = greedy_search(start, goal)
bfs_path = bfs(start, goal)

print("Greedy Path:")
print(greedy_path)

print("\nBFS Path:")
print(bfs_path)

print("\nGreedy Path Length:", len(greedy_path))
print("BFS Path Length:", len(bfs_path))
