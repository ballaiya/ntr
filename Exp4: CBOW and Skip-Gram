from gensim.models import Word2Vec

# Sample corpus
sentences = [
    ["king", "is", "a", "strong", "man"],
    ["queen", "is", "a", "wise", "woman"],
    ["boy", "is", "a", "young", "man"],
    ["girl", "is", "a", "young", "woman"],
    ["prince", "is", "a", "young", "king"],
    ["princess", "is", "a", "young", "queen"],
    ["man", "is", "strong"],
    ["woman", "is", "pretty"],
    ["prince", "is", "boy"],
    ["princess", "is", "girl"]
]

# Train CBOW Model (sg=0)
cbow_model = Word2Vec(
    sentences,
    vector_size=100,
    window=5,
    min_count=1,
    workers=4,
    sg=0
)

# Train Skip-Gram Model (sg=1)
skipgram_model = Word2Vec(
    sentences,
    vector_size=100,
    window=5,
    min_count=1,
    workers=4,
    sg=1
)

# Compare Semantic Similarity
word1 = "king"
word2 = "queen"

cbow_similarity = cbow_model.wv.similarity(word1, word2)
skipgram_similarity = skipgram_model.wv.similarity(word1, word2)

print("CBOW Similarity (king, queen):", cbow_similarity)
print("Skip-Gram Similarity (king, queen):", skipgram_similarity)

# Most Similar Words
print("\nCBOW - Words similar to 'king':")
print(cbow_model.wv.most_similar("king"))

print("\nSkip-Gram - Words similar to 'king':")
print(skipgram_model.wv.most_similar("king"))
